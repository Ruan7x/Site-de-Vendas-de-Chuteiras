# Copie para .env e preencha. NUNCA faça commit do .env.

# --- Servidor ---
PORT=3001
# Endereço do SITE no navegador do cliente (para onde o Mercado Pago devolve o comprador)
PUBLIC_URL=http://localhost:5173
# URL PÚBLICA https que o Mercado Pago alcança para enviar webhooks (não pode ser localhost).
# Em desenvolvimento use um túnel (ex.: ngrok http 3001) e cole a URL aqui.
# Sem isso o pedido ainda é confirmado quando o cliente volta para a página /pedido.
WEBHOOK_BASE_URL=https://SEU-TUNEL.ngrok-free.app
# Atrás de proxy reverso (Nginx, Render, etc.): TRUST_PROXY=1
# TRUST_PROXY=1

# --- Mercado Pago (Checkout Pro) ---
# Rótulo do ambiente: sandbox (credenciais de teste) | production (credenciais reais).
# O Mercado Pago não tem mais URL de sandbox; o que define teste x real é o Access Token.
MP_ENV=sandbox
# Access Token da aplicação (Suas integrações > Credenciais). Em desenvolvimento use as
# credenciais de TESTE de uma conta de teste. Só no servidor, nunca no front-end.
MP_ACCESS_TOKEN=
# "Assinatura secreta" do webhook (Suas integrações > Webhooks > Configurar notificações).
# Usada para validar o header x-signature. Sem ela os webhooks são recusados.
MP_WEBHOOK_SECRET=
# true (padrão) descarta webhooks sem x-signature válida
MP_REQUIRE_SIGNATURE=true

# --- WhatsApp da loja (código do Brasil + DDD + número, só dígitos) ---
WHATSAPP_NUMBER=55DDDNUMERO

# --- Admin ---
# Senha do painel /admin. Se tiver espaço ou "#", coloque entre aspas: ADMIN_PASSWORD="minha #senha"
ADMIN_PASSWORD=
# Texto aleatório longo (ex.: openssl rand -hex 32)
SESSION_SECRET=

# --- Dados (padrões abaixo) ---
# DATABASE_PATH=./data/tn-sports.db
# Fotos dos produtos (públicas)
# UPLOADS_DIR=./data/uploads
# Fotos enviadas pelos clientes (só o admin vê)
# FEEDBACK_UPLOADS_DIR=./data/feedback-uploads
