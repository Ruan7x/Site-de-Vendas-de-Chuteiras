# Copie para .env e preencha. NUNCA faça commit do .env.

# --- Servidor ---
PORT=3001
# URL onde o SITE abre no navegador do cliente (usada no redirect_url do PagBank)
PUBLIC_URL=http://localhost:5173
# URL PÚBLICA que o PagBank consegue acessar para enviar webhooks (https).
# Em desenvolvimento use um túnel (ex.: ngrok http 3001) e cole a URL aqui.
WEBHOOK_BASE_URL=https://SEU-TUNEL.ngrok-free.app
# Atrás de proxy reverso (Nginx, Render, etc.): TRUST_PROXY=1
# TRUST_PROXY=1

# --- PagBank ---
PAGBANK_ENV=sandbox            # sandbox | production
PAGBANK_TOKEN=                 # token da conta (sandbox em dev). Só no servidor!
# true (padrão) descarta webhooks sem assinatura x-authenticity-token válida
PAGBANK_REQUIRE_SIGNATURE=true
# Opcional: parcelas sem juros assumidas pela loja (o site anuncia "até 12x sem juros")
# PAGBANK_INTEREST_FREE_INSTALLMENTS=12

# --- WhatsApp da loja (código do Brasil + DDD + número, só dígitos) ---
WHATSAPP_NUMBER=55DDDNUMERO

# --- Admin ---
ADMIN_PASSWORD=                # defina uma senha forte
SESSION_SECRET=                # string aleatória longa (ex.: openssl rand -hex 32)

# --- Dados (padrões abaixo) ---
# DATABASE_PATH=./data/tn-sports.db
# UPLOADS_DIR=./data/uploads
